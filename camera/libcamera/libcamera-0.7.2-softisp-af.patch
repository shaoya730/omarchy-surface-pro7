+	if (afEnabled_) {
+		if (const auto mode = frameContext.afMode) {
+			if (*mode != afMode_ && (*mode == libcamera::controls::AfModeAuto ||
+						 *mode == libcamera::controls::AfModeContinuous)) {
+				afMode_ = *mode;
+				af_.cancel();
+				af_.setContinuous(afMode_ == libcamera::controls::AfModeContinuous);
+				if (afMode_ == libcamera::controls::AfModeContinuous)
+					af_.trigger(frame);
+			}
+		}
+		if (afMode_ == libcamera::controls::AfModeAuto) {
+			if (const auto trigger = frameContext.afTrigger) {
+				if (*trigger == libcamera::controls::AfTriggerStart)
+					af_.trigger(frame);
+				else
+					af_.cancel();
+			}
+		}
+	}
